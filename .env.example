TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
SCRAPER_CONTACT=you@example.com

# Use postgres_data for Docker-managed local storage or an absolute host path.
POSTGRES_DATA_SOURCE=postgres_data
POSTGRES_DB=apartment_alerts
POSTGRES_USER=apartment
POSTGRES_PASSWORD=change-me-postgres

RABBITMQ_USER=radar
RABBITMQ_PASSWORD=change-me-rabbitmq

# Used when running the Go application directly on the host.
DATABASE_URL=postgresql://apartment:change-me-postgres@localhost:5432/apartment_alerts
RABBITMQ_URL=amqp://radar:change-me-rabbitmq@localhost:5672/
POLL_INTERVAL_SECONDS=180
LOG_LEVEL=INFO

# Optional when running the Go app on the host. Compose sets its internal URL.
# Start the Compose sidecar or service.py directly and use http://localhost:8080.
DOMIMAPS_DETAIL_URL=
DOMIMAPS_DETAIL_TIMEOUT_SECONDS=20
# Loopback port published by the Compose sidecar for host-run development.
DOMIMAPS_DETAIL_HOST_PORT=8080

# Property matching, advert availability tracking, and duplicate-aware alerts.
DEDUPLICATION_ENABLED=true
